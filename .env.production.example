# Production access for `just prod psql | tunnel | stop` (scripts/prod/).
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# .env.production is git-ignored. It is sourced by bash: quote any value with spaces.
# Every key is prefixed AGENTS_PROD_ on purpose, so it never defines anything the app reads
# (AGENTS_DATABASE_URL and friends come from the Komodo stack, not from here).

# ── SSH to reko-3 ────────────────────────────────────────────────────────────
# An ~/.ssh/config alias works; with no key below, ~/.ssh/config decides.
AGENTS_PROD_SSH_HOST=reko-3
# AGENTS_PROD_SSH_USER=woz
# Optional: a key held by the 1Password SSH agent (fingerprint or item title), or a key file.
# AGENTS_PROD_SSH_1P_KEY=SHA256:your-key-fingerprint
# AGENTS_PROD_SSH_KEY=~/.ssh/your-key

# ── PostgreSQL (a container on the stack's private Docker network) ───────────
AGENTS_PROD_PG_PROJECT=agents
AGENTS_PROD_PG_SERVICE=postgres
AGENTS_PROD_PG_NETWORK=agents-prod-internal
AGENTS_PROD_PG_USER=agents
AGENTS_PROD_PG_DB=agents
AGENTS_PROD_PG_PASSWORD=the-AGENTS_DB_PASSWORD-of-the-Komodo-stack
AGENTS_PROD_TUNNEL_PORT=15433
