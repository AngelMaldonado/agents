#!/usr/bin/env python3
# The owner's terminal (#27): an interactive bash on a pseudo-terminal. stdin goes to it, its output to
# stdout, and fd 3 takes "cols rows" lines to resize it. No native modules: Python's own pty.
import fcntl
import os
import pty
import select
import struct
import sys
import termios

pid, fd = pty.fork()
if pid == 0:
    os.environ["TERM"] = "xterm-256color"
    os.chdir(os.environ.get("HOME", "/home/agent"))
    os.execvp("bash", ["bash", "-i"])  # not a login shell: /etc/profile would reset the PATH


def resize(line):
    try:
        cols, rows = (max(1, min(500, int(n))) for n in line.split()[:2])
    except ValueError:
        return
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


def write_all(target, data):
    while data:
        n = os.write(target, data)
        data = data[n:]


inputs, control = [fd, 0, 3], b""
while fd in inputs:
    ready, _, _ = select.select(inputs, [], [])
    if fd in ready:
        try:
            data = os.read(fd, 65536)
        except OSError:
            data = b""
        if not data:
            break
        write_all(1, data)
    if 0 in ready:
        data = os.read(0, 65536)
        if not data:
            break
        write_all(fd, data)
    if 3 in ready:
        data = os.read(3, 4096)
        if not data:
            inputs.remove(3)
        control += data
        while b"\n" in control:
            line, control = control.split(b"\n", 1)
            resize(line.decode(errors="ignore"))

try:
    os.kill(pid, 15)
except ProcessLookupError:
    pass
os.waitpid(pid, 0)
sys.exit(0)
