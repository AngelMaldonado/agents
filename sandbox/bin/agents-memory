#!/bin/sh
# Memoria (mem_save/search/forget): what the agent knows from one trabajo to the next, kept by the platform.
# Usage: agents-memory <save|search|forget> '<json>'
if [ -z "$1" ] || [ -z "$2" ]; then echo 'Uso: agents-memory <save|search|forget> <json>' >&2; exit 2; fi
exec curl -sS --max-time 30 -X POST -H 'content-type: application/json' --data-binary "$2" "http://127.0.0.1:7777/memory/$1"
