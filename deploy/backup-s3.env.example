# Agregar a Environment del stack `agents` de Komodo, NO a .env.production del Mac.
# El render privado de Komodo debe quedar en /etc/komodo/stacks/agents/.env (0600).
# No agregar estas variables a server/sandbox; sólo las lee el helper de backup en reko-3.
# Mantener false hasta configurar destino y guardar credenciales/contraseña en 1Password.
AGENTS_BACKUP_S3_ENABLED=false

# AWS o S3 compatible, HTTPS y prefijo dedicado; bucket debe existir.
# Ejemplo de FORMA (no destino configurado): s3:https://s3.amazonaws.com/mi-bucket/agents/prod
AGENTS_BACKUP_S3_REPOSITORY=
AGENTS_BACKUP_S3_REGION=us-east-1

AGENTS_BACKUP_S3_ACCESS_KEY_ID=
AGENTS_BACKUP_S3_SECRET_ACCESS_KEY=
# Opcional, sólo para credenciales temporales.
AGENTS_BACKUP_S3_SESSION_TOKEN=

# Contraseña aleatoria independiente, mínimo 20 caracteres; NO reutilizar AGENTS_MASTER_KEY.
# Perderla hace irrecuperable el repositorio, aunque se conserven las claves de S3.
AGENTS_BACKUP_S3_PASSWORD=
